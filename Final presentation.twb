    <worksheet name='Transfer Sales Gap by Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='18'>Transfer sales by gap category - 2019</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Montgomery_Retail_Warehouse_Tableau_Ready(1)' name='federated.1gksqwb0q4wheg1ci32z519t5yzl' />
          </datasources>
          <datasource-dependencies datasource='federated.1gksqwb0q4wheg1ci32z519t5yzl'>
            <column caption='Transfers minus Sales' datatype='real' name='[Calculation_0850264488054784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([RETAIL TRANSFERS]) - ZN([RETAIL SALES])' />
            </column>
            <column caption='Transfer Gap Status' datatype='string' name='[Calculation_0850264488579073]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_0850264488054784]) &lt; 0 THEN&#13;&#10;    &quot;Transfers Below Sales&quot;&#13;&#10;ELSEIF SUM([Calculation_0850264488054784]) &gt; 0 THEN&#13;&#10;    &quot;Transfers Above Sales&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Balanced&quot;&#13;&#10;END' />
            </column>
            <column caption='Item Type' datatype='string' name='[ITEM TYPE]' role='dimension' type='nominal' />
            <column caption='Retail Sales' datatype='real' name='[RETAIL SALES]' role='measure' type='quantitative' />
            <column caption='Retail Transfers' datatype='real' name='[RETAIL TRANSFERS]' role='measure' type='quantitative' />
            <column caption='Year' datatype='integer' name='[YEAR]' role='dimension' type='quantitative' />
            <column-instance column='[ITEM TYPE]' derivation='None' name='[none:ITEM TYPE:nk]' pivot='key' type='nominal' />
            <column-instance column='[YEAR]' derivation='None' name='[none:YEAR:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0850264488054784]' derivation='Sum' name='[sum:Calculation_0850264488054784:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0850264488579073]' derivation='User' name='[usr:Calculation_0850264488579073:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1gksqwb0q4wheg1ci32z519t5yzl].[none:ITEM TYPE:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:ITEM TYPE:nk]' member='&quot;BEER&quot;' />
              <groupfilter function='member' level='[none:ITEM TYPE:nk]' member='&quot;KEGS&quot;' />
              <groupfilter function='member' level='[none:ITEM TYPE:nk]' member='&quot;LIQUOR&quot;' />
              <groupfilter function='member' level='[none:ITEM TYPE:nk]' member='&quot;NON-ALCOHOL&quot;' />
              <groupfilter function='member' level='[none:ITEM TYPE:nk]' member='&quot;WINE&quot;' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.1gksqwb0q4wheg1ci32z519t5yzl].[none:YEAR:qk]' included-values='in-range'>
            <min>2019</min>
            <max>2019</max>
          </filter>
