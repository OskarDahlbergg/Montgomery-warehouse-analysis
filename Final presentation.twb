              </zone>
              <zone forceUpdate='true' h='7555' id='11' type-v2='text' w='98858' x='571' y='889'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='20'>Retail Distribution Efficiency — Montgomery County (2019)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#444444' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='14555' id='12' type-v2='text' w='98858' x='571' y='84556'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Key Finding:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'> In January–November 2019, retail transfers were approximately 6,651 cases below retail sales. Wine had the largest negative difference (−2,652 cases), followed by beer (−2,248) and non-alcoholic beverages (−1,768). These differences suggest areas for further replenishment review but do not, on their own, prove inventory shortages.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#444444' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#444444' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
